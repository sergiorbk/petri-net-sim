<?xml version="1.0" encoding="UTF-8"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
   <net id="Dispatcher-and-a-group-of-servers"
        type="http://www.pnml.org/version-2009/grammar/ptnet">
      <name>
         <text>Dispatcher and a group of servers</text>
      </name>
      <page id="object0">
         <name>
            <text>Dispatcher</text>
         </name>
         <toolspecific tool="PetriObjModel" version="2.3.0">
            <petriObject height="200"
                         index="0"
                         name="Dispatcher"
                         priority="2"
                         width="560"
                         x="80"
                         y="60"/>
         </toolspecific>
         <place id="d_queue">
            <name>
               <text>Queue</text>
            </name>
            <initialMarking>
               <text>12</text>
            </initialMarking>
            <graphics>
               <position x="160" y="170"/>
            </graphics>
         </place>
         <place id="d_sent">
            <name>
               <text>Sent</text>
            </name>
            <graphics>
               <position x="400" y="170"/>
            </graphics>
         </place>
         <place id="d_ack">
            <name>
               <text>Ack</text>
            </name>
            <graphics>
               <position x="540" y="170"/>
            </graphics>
         </place>
         <transition id="d_dispatch">
            <name>
               <text>Dispatch</text>
            </name>
            <toolspecific tool="PetriObjModel" version="2.3.0">
               <timeDelay>0.5</timeDelay>
               <delayMeanValue>0.5</delayMeanValue>
            </toolspecific>
            <graphics>
               <position x="280" y="170"/>
            </graphics>
         </transition>
         <arc id="arc-1b87c2b0" source="d_queue" target="d_dispatch">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
         <arc id="arc-25ce4d59" source="d_dispatch" target="d_sent">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
      </page>
      <page id="object1">
         <name>
            <text>Server 1</text>
         </name>
         <toolspecific tool="PetriObjModel" version="2.3.0">
            <petriObject height="220"
                         index="1"
                         name="Server 1"
                         priority="0"
                         width="400"
                         x="80"
                         y="360"/>
         </toolspecific>
         <referencePlace id="s1_task" ref="d_sent">
            <name>
               <text>Task</text>
            </name>
            <toolspecific tool="PetriObjModel" version="2.3.0">
               <referenceRole>fusion</referenceRole>
            </toolspecific>
            <graphics>
               <position x="150" y="470"/>
            </graphics>
         </referencePlace>
         <place id="s1_busy">
            <name>
               <text>Busy</text>
            </name>
            <initialMarking>
               <text>1</text>
            </initialMarking>
            <graphics>
               <position x="150" y="560"/>
            </graphics>
         </place>
         <referencePlace id="s1_ack" ref="d_ack">
            <name>
               <text>Ack</text>
            </name>
            <toolspecific tool="PetriObjModel" version="2.3.0">
               <referenceRole>fusion</referenceRole>
            </toolspecific>
            <graphics>
               <position x="390" y="470"/>
            </graphics>
         </referencePlace>
         <transition id="s1_serve">
            <name>
               <text>Serve</text>
            </name>
            <toolspecific tool="PetriObjModel" version="2.3.0">
               <timeDelay>3.0</timeDelay>
               <delayMeanValue>3.0</delayMeanValue>
            </toolspecific>
            <graphics>
               <position x="270" y="470"/>
            </graphics>
         </transition>
         <arc id="arc-5280d23d" source="s1_task" target="s1_serve">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
         <arc id="arc-0e7fbddf" source="s1_busy" target="s1_serve">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
         <arc id="arc-212509f2" source="s1_serve" target="s1_ack">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
         <arc id="arc-bf18a403" source="s1_serve" target="s1_busy">
            <inscription>
               <text>1</text>
            </inscription>
         </arc>
      </page>
