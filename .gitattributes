# Normalize line endings. Shell scripts MUST stay LF or they break when used
# as a container entrypoint (the kernel can't resolve a CRLF shebang).
* text=auto eol=lf
*.sh text eol=lf
entrypoint.sh text eol=lf

# Binary / lock files — leave untouched
*.png binary
*.jpg binary
*.gif binary
*.ico binary
uv.lock -text
package-lock.json -text

# ─── Media, in Git LFS ───────────────────────────────────────────────────────
# The README's screenshots and animations. Scoped to docs/assets and to image
# formats only: the demo nets beside them are PNML, which is text that diffs
# and reviews, and has no business in LFS.
#
# A clone made without git-lfs installed gets pointer files where the images
# should be; `git lfs pull` fixes it.
docs/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.gif filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.webp filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
docs/assets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
