# =============================================================================
# Petri Net Sim — environment configuration
# =============================================================================
# Copy this file to .env and adjust as needed:
#
#   cp .env.example .env
#
# Every value has a working default, so the stack runs with zero configuration
# (`docker compose up -d --build`). Override only what you need.
# =============================================================================

# ─── Published ports (host side) ─────────────────────────────────────────────
FRONTEND_PORT=6200          # UI + API proxy (production stack)
BACKEND_PORT=6201           # Backend API / docs (direct access)
DB_PORT=6202                # PostgreSQL exposed on the host (dev tools)
# FRONTEND_DEV_PORT=6203    # Vite dev server (dev overlay only)

# ─── Application ─────────────────────────────────────────────────────────────
# APP_ENV drives production hardening. "local" boots with relaxed defaults and
# API docs on. Set "prod" for deployed environments — the backend then REFUSES
# to start with insecure config (default JWT secret, noop cipher, debug on),
# so you must supply AUTH_JWT_SECRET_KEY and CREDENTIALS_MASTER_KEY below.
APP_ENV=local

# Public base URL used to build absolute links (e.g. PNML downloads). Point it
# at the backend as reachable from the user's browser. For a server behind a
# domain, set this to your public URL.
APP_PUBLIC_URL=http://localhost:6201

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_NAME=petri_net_sim
DB_USER=petri_net_sim
DB_PASSWORD=petri_net_sim

# ─── Auth / crypto secrets ───────────────────────────────────────────────────
# AUTH_MODE controls whether the app has accounts at all.
#   multi        accounts required: signup/login/OAuth, JWT + API-key auth
#                (default)
#   single_user  no login. Every request runs as one fixed local account;
#                the signup/login/OAuth endpoints are disabled. For a
#                personal, locally-run instance only: if APP_ENV=prod, the
#                backend logs a prominent startup warning that the server is
#                open to anyone who can reach it, since there is no other
#                access control at this layer.
AUTH_MODE=multi

# Leave blank to auto-generate on first start (stored in the `secrets` volume,
# printed once to the backend logs). Set explicit values for reproducible
# deployments. REQUIRED when APP_ENV=prod.
#   Generate a Fernet master key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AUTH_JWT_SECRET_KEY=
CREDENTIALS_CIPHER=fernet
CREDENTIALS_MASTER_KEY=

# ─── LLM provider ────────────────────────────────────────────────────────────
# This app is BYOK (Bring Your Own Key): every user adds their own LLM API key
# (OpenAI / Anthropic / Ollama) via the in-app Settings page. There is no
# server-side shared key to configure here.

# ─── Simulation backend ──────────────────────────────────────────────────────
# Which engine runs a model. The built-in Python engine is the default and
# handles both v1 (a single flat net) and v2 (a composed Petri-object model,
# POST /api/v1/simulate/composed).
#
#   builtin  the engine that ships with this service (default)
#   remote   an external petri-server instance (the Java engine, see
#            https://github.com/StetsenkoInna/PetriObjModelPaint), given by
#            SIMULATION_REMOTE_URL below
#
# Setting a URL is not on its own a request to compute there: switch the
# engine explicitly, so a leftover address cannot route every run through a
# service that is not deployed.
SIMULATION_ENGINE=builtin

# Base URL of the external engine. Read only when SIMULATION_ENGINE=remote,
# which then requires it (startup fails if it is blank).
#
# Bundled via the `petri-server` Compose profile (defaults to
# PetriObjModelPaint checked out as a sibling directory; set
# PETRI_SERVER_BUILD_CONTEXT below if it lives elsewhere):
#   docker compose --profile petri-server up -d --build
#   SIMULATION_REMOTE_URL=http://petri-server:8080
#
# Running petri-server outside Docker on the host instead:
#   SIMULATION_REMOTE_URL=http://host.docker.internal:8080
SIMULATION_REMOTE_URL=

# What happens when the external engine is unreachable, for SIMULATION_ENGINE=
# remote only: true runs the model on the built-in engine instead and says so
# on the stream, false reports the failure and simulates nothing.
SIMULATION_REMOTE_FALLBACK=true

# Host port for the bundled petri-server Compose profile (see above).
PETRI_SERVER_PORT=6205

# Path to the PetriObjModelPaint checkout, for the petri-server Compose
# profile's build context. Only needed if it isn't a sibling of this repo.
# PETRI_SERVER_BUILD_CONTEXT=../PetriObjModelPaint

# ─── Runtime ─────────────────────────────────────────────────────────────────
UVICORN_WORKERS=2
