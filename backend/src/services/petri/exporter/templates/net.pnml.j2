{% import "_toolspecific.pnml.j2" as ts %}
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>{{ net.name | default('Generated by Petri Net Sim') }}</text>
    </name>
    <page id="page1">

    {# --- PLACES --- #}
    {% for place in net.places %}
    <place id="{{ place.id }}">
      <name>
        <text>{{ place.name }}</text>
      </name>
      {% if place.tokens > 0 %}
      <initialMarking>
        <text>{{ place.tokens }}</text>
      </initialMarking>
      {% endif %}
      {# A plain place has nothing left to say in toolspecific once #}
      {# <coordinates> is gone (PNML ISO conformance contract, decision 1): #}
      {# no block at all, same precedent as a NORMAL arc below. #}
      <graphics>
        <position x="{{ (place.graphics.x + PLACE_W / 2) | round_half_up }}" y="{{ (place.graphics.y + PLACE_H / 2) | round_half_up }}"/>
      </graphics>
    </place>
    {% endfor %}

    {# --- TRANSITIONS --- #}
    {% for trans in net.transitions %}
    <transition id="{{ trans.id }}">
      <name>
        <text>{{ trans.name }}</text>
      </name>
      {% call ts.toolspecific() %}
        {% if trans.probability is not none %}
        <probability>{{ trans.probability }}</probability>
        {% elif trans.distribution %}
        <timeDelay>{{ trans.mean_delay }}</timeDelay>
        <delayMeanValue>{{ trans.mean_delay }}</delayMeanValue>
        <distribution>{{ trans.distribution.value }}</distribution>
        {% if trans.distribution.value in ['norm', 'unif'] %}
        <standardDeviation>{{ trans.standard_deviation }}</standardDeviation>
        {% endif %}
        {% else %}
        <timeDelay>0</timeDelay>
        <delayMeanValue>0</delayMeanValue>
        <distribution>det</distribution>
        {% endif %}
        {% if trans.probability is none %}
        <priority>{{ trans.priority }}</priority>
        {% endif %}
      {% endcall %}
      <graphics>
        <position x="{{ (trans.graphics.x + TRANS_W / 2) | round_half_up }}" y="{{ (trans.graphics.y + TRANS_H / 2) | round_half_up }}"/>
      </graphics>
    </transition>
    {% endfor %}

    {# --- ARCS --- #}
    {% for arc in net.arcs %}
    <arc id="{{ arc.id }}" source="{{ arc.source_id }}" target="{{ arc.target_id }}">
      <graphics/>
      <inscription>
        <text>{{ arc.weight }}</text>
      </inscription>
      {% if arc.arc_type != 'normal' %}
      {% call ts.toolspecific() %}
        {# .value, not the bare enum: Python 3.11+ changed Enum.__str__ so #}
        {# str(ArcType.INHIBITOR) == "ArcType.INHIBITOR" even though ArcType #}
        {# mixes in str, and petri-server's parser compares this text #}
        {# against the literal "inhibitor"/"read" (PnmlParser.java:317, see #}
        {# _element_macros.pnml.j2's arc macro, which already has this fix #}
        {# for the composed path). #}
        <arcType>{{ arc.arc_type.value }}</arcType>
      {% endcall %}
      {# No standard-namespace <type value="inhibitorArc"/> sibling here: #}
      {# ptnet's arc content model (arc.labels) allows only an optional #}
      {# <inscription>, so a <type> child is not RELAX NG conformant. The #}
      {# toolspecific <arcType> above already carries "inhibitor" for every #}
      {# reader in this family (PetriObjModelPaint's parser and petri-server #}
      {# both read it), so nothing downstream loses the information. #}
      {% endif %}
    </arc>
    {% endfor %}

    </page>
  </net>
</pnml>
