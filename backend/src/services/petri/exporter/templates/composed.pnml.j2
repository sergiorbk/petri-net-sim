{% import '_element_macros.pnml.j2' as el %}
{% import '_toolspecific.pnml.j2' as ts %}
<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<pnml xmlns="http://www.pnml.org/version-2009/grammar/pnml">
  <net id="net1" type="http://www.pnml.org/version-2009/grammar/ptnet">
    <name>
      <text>{{ doc.name | default('Generated by Petri Net Sim') }}</text>
    </name>
    {# A nested object's page is written inside its parent's: that is how #}
    {# ISO/IEC 15909-2 states a page hierarchy, and the only form of it a #}
    {# reader outside this family can see. Children come last, in index #}
    {# order, which is the position both writers in this family agree on. #}
    {% for obj in doc.root_objects recursive %}
    <page id="object{{ obj.index }}">
      <name>
        <text>{{ obj.name }}</text>
      </name>
      {% call ts.toolspecific() %}
        <petriObject index="{{ obj.index }}" name="{{ obj.name }}" priority="{{ obj.priority }}"
                      x="{{ obj.x | round_half_up }}" y="{{ obj.y | round_half_up }}"{% if obj.width is not none %} width="{{ obj.width | round_half_up }}" height="{{ obj.height | round_half_up }}"{% endif %}{% if obj.collapsed %} collapsed="true"{% endif %}{% if obj.auto_fit == false %} autoFit="false"{% endif %}/>
        {% if obj.template_method %}
        <netTemplate method="{{ obj.template_method }}">
          {% for arg in obj.template_arguments %}
          <argument>{{ arg }}</argument>
          {% endfor %}
        </netTemplate>
        {% endif %}
      {% endcall %}

      {# Place slots: a real <place>, or, at the exact ordinal the fused- #}
      {# away place would have had, the fusion's <referencePlace> (§3). #}
      {% for slot in obj.place_slots %}
      {% if slot.slot_kind == 'place' %}
      {{ el.place(slot.place, id=slot.id) }}
      {% else %}
      {{ el.reference_place(slot, role='fusion') }}
      {% endif %}
      {% endfor %}

      {% for trans in obj.transitions %}
      {{ el.transition(trans.transition, id=trans.id) }}
      {% endfor %}

      {# Representatives never consume a slot ordinal, they are added #}
      {# after every real place/transition, in link order (§3). #}
      {% for rep in obj.representatives %}
      {% if rep.target_kind == 'place' %}
      {{ el.reference_place(rep, role='representative') }}
      {% else %}
      {{ el.reference_transition(rep, role='representative') }}
      {% endif %}
      {% endfor %}

      {% for oa in obj.own_arcs %}
      {{ el.arc(oa.arc, id=oa.id, source_id=oa.source_id, target_id=oa.target_id) }}
      {% endfor %}
      {% for la in obj.link_arcs %}
      {{ el.link_arc(la) }}
      {% endfor %}
      {{ loop(obj.children) }}
    </page>
    {% endfor %}

    {# Still emitted at 2.1, now id-addressed too (§6), kept for a reader #}
    {# that does not implement reference nodes yet (an already-deployed #}
    {# petri-server, a saved-file reader). It recovers a transitionToPlace #}
    {# link in full from this block; it cannot rescue placeFusion, because #}
    {# the conformant projection actually removes a <place>, nothing but #}
    {# the reference node can stand in for that. placeToTransition never #}
    {# reaches here at all: PetriObjModelPaint retired that link type, and #}
    {# build_document_model refuses a model that still has one before this #}
    {# template ever runs. Otherwise this block is redundant with the #}
    {# structure above: for a CONFORMANT reader, every placeFusion entry #}
    {# here is ignored (the reference nodes are the complete set, fusion is #}
    {# destructive and replaying it further would keep chaining wires), and #}
    {# transitionToPlace entries are the union, deduplicated, with the #}
    {# structure winning on quantity when both agree to disagree. #}
    {% if doc.links %}
    {% call ts.toolspecific() %}
      <petriObjectLinks>
        {% for rl in doc.links %}
        <link type="{{ rl.link.type.value }}"
              sourceObject="{{ rl.link.source_object }}" sourceElement="{{ rl.link.source_element }}"
              sourceElementId="{{ rl.source_element_id }}"
              targetObject="{{ rl.target_object }}" targetElement="{{ rl.target_element }}"
              targetElementId="{{ rl.target_element_id }}"
              {% if rl.link.type.value != 'placeFusion' %}quantity="{{ rl.link.quantity }}"{% endif %}/>
        {% endfor %}
      </petriObjectLinks>
    {% endcall %}
    {% endif %}
  </net>
</pnml>
